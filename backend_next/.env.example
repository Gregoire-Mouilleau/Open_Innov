# ─── PostgreSQL + TimescaleDB ─────────────────────────────────────────────────
POSTGRES_USER=techfarm
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=techfarm
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://techfarm:CHANGE_ME@localhost:5432/techfarm

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_USER=techfarm
MONGO_PASSWORD=CHANGE_ME
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=techfarm
MONGODB_URI=mongodb://techfarm:CHANGE_ME@localhost:27017/techfarm?authSource=admin

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_PHOTOS=techfarm-photos

# ─── Next.js ──────────────────────────────────────────────────────────────────
# Jamais préfixé NEXT_PUBLIC_ = variable serveur uniquement (credentials DB)
# Préfixé NEXT_PUBLIC_ = exposé au navigateur (URL API publique uniquement)
NEXTAUTH_SECRET=CHANGE_ME
NEXTAUTH_URL=http://localhost:3000

# ─── API externe ──────────────────────────────────────────────────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
